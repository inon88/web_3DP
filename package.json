{
  "name": "bonastudio-web",
  "version": "0.1.0",
  "private": true,
  "description": "BonaStudio in the browser: parametric OpenSCAD tools rendered locally with WebAssembly",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-from-app.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "library": "node scripts/build-library.mjs",
    "google-fonts": "node scripts/google-fonts.mjs",
    "thumbnails": "node scripts/gallery-thumbnails.mjs",
    "prepare-all": "npm run sync && npm run assets && npm run library",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/",
    "build:full": "npm run prepare-all && vite build"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "fflate": "0.8.3",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "vite": "8.3.5"
  }
}
